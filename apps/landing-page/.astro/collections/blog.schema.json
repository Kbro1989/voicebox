{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string",
      "enum": [
        "Product",
        "Guides",
        "Use cases",
        "Community"
      ]
    },
    "readingTime": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "summary": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "i18n": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "bodyHtml": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date",
    "category",
    "readingTime",
    "summary"
  ],
  "additionalProperties": {}
}